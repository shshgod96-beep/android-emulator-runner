name: Run Android Emulator
on: 
  workflow_dispatch: # هذا يجعلك قادراً على تشغيله يدوياً من قسم Actions

jobs:
  run-emulator:
    runs-on: ubuntu-latest # يُنصح باستخدام أوبونتو لأنه أسرع ويدعم تسريع الهاردوير الآن
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Enable KVM (تسريع الهاردوير للمحاكي)
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm

      - name: Start Android Emulator
        # هنا نستدعي الأداة التي نتحدث عنها لتشغيل المحاكي
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 29 # إصدار الأندرويد
          target: default
          arch: x86_64
          profile: pixel_6
          script: echo "المحاكي يعمل الآن بنجاح!" && sleep 3600 
          # أمر sleep 3600 سيجعل السيرفر يظل يعمل لمدة ساعة إذا كنت تريد الاتصال به
